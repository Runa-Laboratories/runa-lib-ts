{
  "name": "@runa/sdk",
  "version": "0.1.0",
  "description": "The official TypeScript SDK for Runa.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "test": "npm run build && node --test --test-reporter=spec test/**/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "contract:verify": "node scripts/verify-contract.mjs",
    "surface:verify": "node scripts/verify-surface.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "security:verify": "node scripts/verify-security.mjs",
    "dependencies:verify": "node scripts/verify-dependencies.mjs",
    "evidence": "node scripts/build-evidence.mjs",
    "quality": "npm run lint && npm run typecheck && npm run contract:verify && npm test && npm run surface:verify && npm run docs:verify && npm run security:verify && npm run dependencies:verify && npm run evidence",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "esbuild": "0.25.5",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
